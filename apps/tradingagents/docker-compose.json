{
  "schemaVersion": 2,
  "services": [
    {
      "name": "tradingagents",
      "image": "python:3.12-slim",
      "isMain": true,
      "internalPort": 8080,
      "command": "/app/start.sh",
      "environment": [
        {"key": "TRADINGAGENTS_LLM_PROVIDER", "value": "${TRADINGAGENTS_LLM_PROVIDER}"},
        {"key": "TRADINGAGENTS_API_KEY", "value": "${TRADINGAGENTS_API_KEY}"},
        {"key": "TRADINGAGENTS_DEFAULT_MODEL", "value": "${TRADINGAGENTS_DEFAULT_MODEL}"},
        {"key": "TRADINGAGENTS_OUTPUT_LANGUAGE", "value": "${TRADINGAGENTS_OUTPUT_LANGUAGE}"},
        {"key": "TRADINGAGENTS_INITIAL_TICKER", "value": "${TRADINGAGENTS_INITIAL_TICKER}"}
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/start.sh",
          "containerPath": "/app/start.sh",
          "readOnly": true
        }
      ],
      "restart": "unless-stopped"
    }
  ]
}
