{
  "schemaVersion": 2,
  "services": [
    {
      "name": "tradingagents",
      "image": "python:3.12-slim",
      "isMain": true,
      "internalPort": 8080,
      "command": "/app/start.sh",
      "environment": {
        "TRADINGAGENTS_LLM_PROVIDER": "${TRADINGAGENTS_LLM_PROVIDER}",
        "TRADINGAGENTS_API_KEY": "${TRADINGAGENTS_API_KEY}",
        "TRADINGAGENTS_DEFAULT_MODEL": "${TRADINGAGENTS_DEFAULT_MODEL}",
        "TRADINGAGENTS_OUTPUT_LANGUAGE": "${TRADINGAGENTS_OUTPUT_LANGUAGE}",
        "TRADINGAGENTS_INITIAL_TICKER": "${TRADINGAGENTS_INITIAL_TICKER}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/web",
          "containerPath": "/app/web",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/server.py",
          "containerPath": "/app/server.py",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/start.sh",
          "containerPath": "/app/start.sh",
          "readOnly": true
        }
      ],
      "restart": "unless-stopped"
    }
  ]
}
