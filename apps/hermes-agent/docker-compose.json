{
  "schemaVersion": 2,
  "services": [
    {
      "name": "hermes-agent",
      "image": "nousresearch/hermes-agent:v2.0.0",
      "isMain": true,
      "internalPort": 9119,
      "command": ["/opt/data/start.sh"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/opt/data"
        }
      ],
      "environment": [
        {
          "key": "OPENROUTER_API_KEY",
          "value": "${OPENROUTER_API_KEY}"
        },
        {
          "key": "TELEGRAM_BOT_TOKEN",
          "value": "${TELEGRAM_BOT_TOKEN}"
        },
        {
          "key": "DEFAULT_MODEL",
          "value": "${DEFAULT_MODEL}"
        },
        {
          "key": "LOCAL_MODEL_URL",
          "value": "${LOCAL_MODEL_URL}"
        },
        {
          "key": "API_SERVER_ENABLED",
          "value": "${API_SERVER_ENABLED}"
        },
        {
          "key": "API_SERVER_HOST",
          "value": "${API_SERVER_HOST}"
        },
        {
          "key": "API_SERVER_PORT",
          "value": "${API_SERVER_PORT}"
        },
        {
          "key": "API_SERVER_KEY",
          "value": "${API_SERVER_KEY}"
        },
        {
          "key": "HERMES_DASHBOARD",
          "value": "${HERMES_DASHBOARD}"
        },
        {
          "key": "TTYD_USER",
          "value": "${TTYD_USER}"
        },
        {
          "key": "TTYD_PASS",
          "value": "${TTYD_PASS}"
        }
      ],
      "restart": "unless-stopped",
      "resources": {
        "memory_limit": "4g",
        "cpu_limit": "2.0"
      }
    }
  ]
}
