{
  "services": [
    {
      "name": "sonnensystem",
      "image": "nginx:alpine",
      "isMain": true,
      "internalPort": "80",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/web",
          "containerPath": "/usr/share/nginx/html",
          "readonly": true
        }
      ],
      "restartPolicy": "unless-stopped"
    }
  ]
}
