{
  "services": [
    {
      "name": "sonnensystem",
      "image": "nginx:alpine",
      "isMain": true,
      "internalPort": "80",
      "volumes": [
        "./web:/usr/share/nginx/html:ro"
      ],
      "restartPolicy": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "3"
        }
      }
    }
  ]
}
