{
  "schemaVersion": 2,
  "services": [
    {
      "name": "flappy-bird-3d",
      "image": "nginx:alpine",
      "isMain": true,
      "internalPort": 8080,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/web",
          "containerPath": "/usr/share/nginx/html",
          "readOnly": true
        }
      ],
      "restart": "unless-stopped"
    }
  ]
}
